{
  "name": "Reliant Web Extension",
  "description": "A web extension that enhances your article reading experience.",
  "version": "1.1",
  "manifest_version": 3,
  "permissions": [
    "contextMenus",
    "storage",
    "identity",
    "identity.email",
    "tabs",
    "webRequest",
    "activeTab",
    "scripting"
  ],
  "options_ui": {
    "page": "options.html"
  },
  "background": {
    "service_worker": "background.bundle.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "128": "icon.png"
    }
  },
  "icons": {
    "128": "icon.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.nytimes.com/*",
        "https://www.theverge.com/*",
        "https://www.wired.com/*",
        "https://www.cnn.com/*",
        "https://www.vox.com/*"
      ],
      "exclude_matches": [
        "https://www.nytimes.com/",
        "https://www.theverge.com/",
        "https://www.wired.com/",
        "https://www.cnn.com/",
        "https://www.vox.com/"
      ],
      "js": ["contentScript.bundle.js"],
      "css": ["content.styles.css"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content.styles.css",
        "icon-128.png",
        "icon-34.png",
        "icon.png"
      ],
      "matches": ["<all_urls>"]
    }
  ], 
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';",
    "service_worker": "script-src 'self';"
  }
}
